# Inverge web — local env. Copy to .env.local.

# inverge-api base URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Canonical site origin — used for metadataBase, canonical URLs, and OpenGraph image
# resolution. Defaults to https://inverge.africa when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Privy embedded-wallet app id (leave empty in dev to run without Privy —
# the AuthProvider renders children directly when unset). See docs §3: Privy
# is confined to a single wrapper so the vendor stays swappable.
NEXT_PUBLIC_PRIVY_APP_ID=
